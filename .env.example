# ─── Database ───
DB_PASSWORD=changeme_in_production
DATABASE_URL=postgresql+asyncpg://admin:${DB_PASSWORD}@postgres:5432/ai_safety

# ─── Redis ───
REDIS_URL=redis://redis:6379/0

# ─── JWT Auth ───
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── LLM Provider Keys (optional — system works with mock data without these) ───
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Scanner Thresholds ───
INJECTION_THRESHOLD=0.85
TOXICITY_THRESHOLD=0.7
HALLUCINATION_THRESHOLD=0.6
BIAS_THRESHOLD=0.6

# ─── Scanner Mode ───
# "lightweight" (regex/heuristic, fast, no model downloads)
# "full" (ML models, requires HuggingFace downloads)
SCANNER_MODE=lightweight

# ─── App Settings ───
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DEFAULT_RATE_LIMIT=100
